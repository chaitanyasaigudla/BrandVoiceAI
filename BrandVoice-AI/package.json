{
  "name": "brandvoice-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BrandVoice AI – Consistent Marketing Content Assistant",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "pnpm --filter './apps/*' test",
    "db:migrate": "pnpm --filter @brandvoice/backend db:migrate",
    "db:generate": "pnpm --filter @brandvoice/backend db:generate",
    "db:studio": "pnpm --filter @brandvoice/backend db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
